{{- $manifest := includeTemplate "omp-plugins.yml" . | fromYaml -}}
{{- if ne .platform "windows" -}}
#!/bin/sh
set -eu
set -x

if ! command -v omp >/dev/null 2>&1; then
  printf '%s\n' 'omp is required to synchronize the plugin manifest.' >&2
  exit 1
fi

marketplace_name={{ $manifest.marketplace.name | toJson }}
marketplace_source={{ $manifest.marketplace.source | toJson }}
marketplace_url="https://github.com/$marketplace_source"
case "$marketplace_source" in
  http://*|https://*)
    marketplace_url="$marketplace_source"
    ;;
esac
marketplaces="$(omp plugin marketplace list)"

if ! printf '%s\n' "$marketplaces" | awk -v name="$marketplace_name" -v source="$marketplace_source" -v url="$marketplace_url" '
  function normalize(value) {
    sub(/\/+$/, "", value)
    return value
  }
  $1 == name && (normalize($2) == normalize(source) || normalize($2) == normalize(url)) {
    found = 1
  }
  END {
    if (found) exit 0
    exit 1
  }
'; then
  if printf '%s\n' "$marketplaces" | awk -v name="$marketplace_name" '
    $1 == name { found = 1 }
    END {
      if (found) exit 0
      exit 1
    }
  '; then
    printf 'Marketplace %s is registered with a different source.\n' "$marketplace_name" >&2
    exit 1
  fi
  omp plugin marketplace add "$marketplace_source"

fi

# Force-install uses cached metadata; refresh it before resolving versions.
omp plugin marketplace update "$marketplace_name"

{{- range $plugin := $manifest.plugins }}
omp plugin install {{ $plugin | toJson }} --scope user --force

{{- end }}
{{- end }}
