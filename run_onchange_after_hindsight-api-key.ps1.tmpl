{{- $config := include "private_dot_omp/private_agent/private_config.yml" | fromYaml -}}
{{- $hindsight := $config.hindsight | toJson -}}
{{- if eq .platform "windows" -}}
$ErrorActionPreference = "Stop"
# Keep tracing off while handling secrets, including values returned by functions.
Set-PSDebug -Off

# The checksum makes this run whenever the rendered Hindsight section changes.
# checksum: {{ $hindsight | sha256sum }}

$previousLastExitCode = $global:LASTEXITCODE
$tempPath = $null

function Set-PrivateFileAcl {
    param([string] $Path)

    # Persist only access rules through .NET. Set-Acl can require audit-related
    # SeSecurityPrivilege when refreshing an already protected file.
    $acl = [System.Security.AccessControl.FileSecurity]::new()
    $acl.SetAccessRuleProtection($true, $false)
    $identity = [System.Security.Principal.WindowsIdentity]::GetCurrent().Name
    $rule = [System.Security.AccessControl.FileSystemAccessRule]::new(
        $identity,
        [System.Security.AccessControl.FileSystemRights]::FullControl,
        [System.Security.AccessControl.AccessControlType]::Allow
    )
    $acl.SetAccessRule($rule)
    $file = [System.IO.FileInfo]::new($Path)
    if ($PSVersionTable.PSEdition -eq "Core") {
        [System.IO.FileSystemAclExtensions]::SetAccessControl($file, $acl)
    }
    else {
        $file.SetAccessControl($acl)
    }
}

try {
    if (-not (Get-Command az -ErrorAction SilentlyContinue)) {
        throw "az is required to refresh OMP secrets."
    }

    $agentDir = if ($env:PI_CODING_AGENT_DIR) {
        $env:PI_CODING_AGENT_DIR
    }
    else {
        Join-Path $HOME ".omp\agent"
    }
    $envFile = Join-Path $agentDir ".env"
    New-Item -ItemType Directory -Path $agentDir -Force | Out-Null

    Write-Output "Reading Azure Hindsight app setting and kv-chezmoi-wu2 secrets."
    $tokenOutput = (& az webapp config appsettings list `
        --resource-group rg-hindsight-wu2 `
        --name app-hindsight-wu2 `
        --query "[?name=='HINDSIGHT_API_TENANT_API_KEY'].value | [0]" `
        --output json | Out-String)

    $azSucceeded = $?
    $azExitCode = $LASTEXITCODE
    if (-not $azSucceeded -or $azExitCode -ne 0) {
        throw "Azure CLI could not read HINDSIGHT_API_TENANT_API_KEY."
    }

    $token = ConvertFrom-Json -InputObject $tokenOutput
    if ([string]::IsNullOrWhiteSpace($token)) {
        throw "Azure app setting HINDSIGHT_API_TENANT_API_KEY is empty or missing."
    }

    if (Test-Path -LiteralPath $envFile -PathType Container) {
        throw "Expected $envFile to be a regular file."
    }

    $secrets = [ordered]@{ HINDSIGHT_API_TOKEN = $token }
    $namesOutput = (& az keyvault secret list --vault-name kv-chezmoi-wu2 --query '[].name' --output json | Out-String)
    if (-not $? -or $LASTEXITCODE -ne 0) {
        throw "Azure CLI could not list kv-chezmoi-wu2 secrets."
    }
    foreach ($name in (ConvertFrom-Json -InputObject $namesOutput)) {
        $key = $name.Replace("-", "_")
        if ($key -cnotmatch '^[A-Za-z_][A-Za-z0-9_]*$') {
            throw "Invalid dotenv secret name: $name"
        }
        if ($key -ceq "HINDSIGHT_API_TOKEN") {
            throw "Vault secret conflicts with HINDSIGHT_API_TOKEN."
        }
        $valueOutput = (& az keyvault secret show --vault-name kv-chezmoi-wu2 --name $name --query value --output json | Out-String)
        if (-not $? -or $LASTEXITCODE -ne 0) {
            throw "Azure CLI could not read vault secret $name."
        }
        $secrets[$key] = ConvertFrom-Json -InputObject $valueOutput
    }

    $imports = [System.Collections.Generic.List[string]]::new()
    foreach ($entry in $secrets.GetEnumerator()) {
        $value = $entry.Value
        if ($value -isnot [string] -or $value -match '[\x00\r\n]') {
            throw "Secret cannot be represented in OMP dotenv."
        }
        # OMP strips literal quotes but does not decode backslash escapes.
        $delimiter = @("'", '"', '`') | Where-Object { -not $value.Contains($_) } | Select-Object -First 1
        if ($null -ne $delimiter -and -not $value.EndsWith("\")) {
            $encoded = $delimiter + $value + $delimiter
        }
        elseif (($value.Length -eq 0 -or $value -match '^[^''"`\s]') -and $value -notmatch '[ \t]#|[ \t]$') {
            $encoded = $value
        }
        else {
            throw "Secret cannot be represented in OMP dotenv."
        }
        [void]$imports.Add($entry.Key + "=" + $encoded)
    }
    $lines = [System.Collections.Generic.List[string]]::new()
    if (Test-Path -LiteralPath $envFile -PathType Leaf) {
        foreach ($line in [System.IO.File]::ReadAllLines($envFile)) {
            if ($line -match '^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=' -and
                @($secrets.Keys) -ccontains $Matches[1]) {
                continue
            }
            [void]$lines.Add($line)
        }
    }
    $lines.AddRange($imports)

    $tempPath = Join-Path $agentDir (".env.tmp-" + [System.Guid]::NewGuid().ToString("N"))
    $utf8 = [System.Text.UTF8Encoding]::new($false)
    [System.IO.File]::WriteAllLines($tempPath, $lines, $utf8)
    if ([System.Environment]::OSVersion.Platform -eq [System.PlatformID]::Win32NT) {
        Set-PrivateFileAcl $tempPath
    }
    if (Test-Path -LiteralPath $envFile -PathType Leaf) {
        [System.IO.File]::Replace($tempPath, $envFile, [System.Management.Automation.Language.NullString]::Value)
    }
    else {
        [System.IO.File]::Move($tempPath, $envFile)
    }
    if ([System.Environment]::OSVersion.Platform -eq [System.PlatformID]::Win32NT) {
        # File.Replace preserves the old destination ACL.
        Set-PrivateFileAcl $envFile
    }
    $tempPath = $null
    $token = $null
    $tokenOutput = $null
    Write-Output "Updated $envFile from Azure Hindsight and kv-chezmoi-wu2."
}
finally {
    if ($null -ne $tempPath) {
        Remove-Item -LiteralPath $tempPath -Force -ErrorAction SilentlyContinue
    }
    $global:LASTEXITCODE = $previousLastExitCode
}
{{- end }}
