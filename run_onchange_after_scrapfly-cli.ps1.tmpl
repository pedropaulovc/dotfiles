{{- $manifest := includeTemplate "scrapfly-cli.json" . | fromJson -}}
{{- if eq .platform "windows" }}
$ErrorActionPreference = "Stop"
Set-PSDebug -Trace 1

$architecture = $env:PROCESSOR_ARCHITEW6432
if (-not $architecture) {
    $architecture = $env:PROCESSOR_ARCHITECTURE
}
if ($architecture -ne "AMD64") {
    throw "Unsupported Scrapfly CLI architecture: $architecture"
}

$version = {{ $manifest.version | toJson }}
$archiveName = {{ (index $manifest.archives "windows-amd64").name | toJson }}
$archiveSha256 = {{ (index $manifest.archives "windows-amd64").sha256 | toJson }}
$tempDir = Join-Path ([System.IO.Path]::GetTempPath()) ("scrapfly-cli-" + [System.Guid]::NewGuid().ToString("N"))
New-Item -ItemType Directory -Path $tempDir | Out-Null
try {
    $archive = Join-Path $tempDir $archiveName
    Invoke-WebRequest -Uri "https://github.com/scrapfly/scrapfly-cli/releases/download/$version/$archiveName" -OutFile $archive
    if ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash -ne $archiveSha256) {
        throw "Scrapfly CLI archive SHA256 mismatch."
    }
    $extractDir = Join-Path $tempDir "extracted"
    Expand-Archive -LiteralPath $archive -DestinationPath $extractDir
    $binDir = Join-Path $env:USERPROFILE ".local/bin"
    New-Item -ItemType Directory -Path $binDir -Force | Out-Null
    Copy-Item -LiteralPath (Join-Path $extractDir "scrapfly.exe") -Destination (Join-Path $binDir "scrapfly.exe") -Force
}
finally {
    Remove-Item -LiteralPath $tempDir -Recurse -Force
}
{{- end }}
