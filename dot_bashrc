# Run an agent shortcut in a temporary project under ~/src/tmp-<name>.
# Temporary projects are removed after seven days without any file or
# directory modification. Continue shortcuts (the *c variants) are
# intentionally not wrapped.
__tmp_project_cleanup() {
  local src_dir=$1
  [ -d "$src_dir" ] || return 0

  local project recent
  while IFS= read -r -d '' project; do
    recent=$(find -P "$project" -newermt '7 days ago' -print -quit 2>/dev/null)
    [ -n "$recent" ] && continue

    printf 'Removing stale temporary project: %s\n' "$project" >&2
    rm -rf -- "$project" || \
      printf 'Unable to remove stale temporary project: %s\n' "$project" >&2
  done < <(
    find -P "$src_dir" -mindepth 1 -maxdepth 1 -type d -name 'tmp-*' \
      -print0 2>/dev/null
  )
}
__tmp_project() {
  local name=${1-}
  local command=${2-}
  local shortcut=${FUNCNAME[1]-$command}

  if [ -z "$name" ]; then
    printf 'Usage: %s <name> [args...]\n' "$shortcut" >&2
    return 2
  fi

  case "$name" in
    .|..|-*|*/*|*\\*)
      printf 'Invalid temporary project name: %s\n' "$name" >&2
      return 2
      ;;
  esac

  shift 2
  local src_dir="$HOME/src"
  local project_dir="$src_dir/tmp-$name"
  mkdir -p -- "$project_dir" || return

  local status
  if (
    cd -- "$project_dir" || exit
    "$command" "$@"
  ); then
    status=0
  else
    status=$?
  fi

  __tmp_project_cleanup "$src_dir"
  return "$status"
}

