# Launch claude inside a tmux session so it keeps running if the terminal dies.
# Reattaches to the existing per-directory session if one is already running.
yct() {
  # Base claude invocation with the flags we always want.
  local args=(claude --verbose --dangerously-skip-permissions --name "${HOSTNAME}-wsl" --worktree)

  # If the project has a systemPrompt in .claude/settings.json, pass it through.
  local sp
  sp=$(jq -r '.systemPrompt // empty' .claude/settings.json 2>/dev/null)
  if [[ -n "$sp" ]]; then
    args+=(--system-prompt "$sp")
  fi

  # Forward any extra args the user passed to yc.
  args+=("$@")

  # tmux new-session takes a single shell-command string, so quote each arg safely.
  local cmd
  cmd=$(printf '%q ' "${args[@]}")

  # One session per working directory — running yc twice in the same dir reattaches
  # instead of spawning a duplicate.
  local session="yc-$(basename "$PWD")"
  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" "$cmd" || return
  fi
  tmux attach-session -t "$session"
}
