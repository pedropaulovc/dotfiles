# Invoke claude with project settings and keep running in current shell.
# Loads systemPrompt from .claude/settings.json if present.
yc() {
  # Base claude invocation with the flags we always want.
  local args=(claude --verbose --dangerously-skip-permissions --name "${HOSTNAME}-wsl")

  # If the project has a systemPrompt in .claude/settings.json, pass it through.
  local sp
  sp=$(jq -r '.systemPrompt // empty' .claude/settings.json 2>/dev/null)
  if [[ -n "$sp" ]]; then
    args+=(--system-prompt "$sp")
  fi

  # Forward any extra args the user passed to yc.
  args+=("$@")

  # Execute claude directly in current shell.
  "${args[@]}"
}

